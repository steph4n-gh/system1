+import { afterEach, describe, expect, it, vi } from "vitest";
+import { classifyWithSystem1 } from "./system1";
+
+const request = {
+  config: {
+    provider: "system1" as const,
+    model: "email",
+    apiKey: "local-service-token",
+    baseUrl: "http://127.0.0.1:8781",
+  },
+  state: { email: { subject: "Your verification code" } },
+  questions: {
+    __rule_choice__: {
+      type: "choice" as const,
+      instructions: "Choose",
+      criteria: { OTP: "Codes" },
+    },
+  },
+};
+const accepted = {
+  model: "system1-email-test",
+  inputTokens: 0,
+  teacherCalls: 0,
+  needsReview: false,
+  answers: {
+    __rule_choice__: {
+      type: "choice",
+      choice: "OTP",
+      confidence: 0.99,
+      probabilities: { OTP: 0.99 },
+    },
+  },
+};
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe("local System1 provider", () => {
+  it("posts to the configured service and accepts a validated zero-token answer", async () => {
+    const fetch = vi.fn().mockResolvedValue(Response.json(accepted));
+    vi.stubGlobal("fetch", fetch);
+    expect(await classifyWithSystem1(request)).toEqual(accepted);
+    expect(fetch).toHaveBeenCalledWith(
+      new URL("http://127.0.0.1:8781/v1/classify"),
+      expect.objectContaining({
+        method: "POST",
+        redirect: "error",
+        signal: expect.any(AbortSignal),
+        headers: expect.objectContaining({
+          Authorization: "Bearer local-service-token",
+        }),
+      }),
+    );
+  });
+  it("preserves review without inventing a choice", async () => {
+    const review = {
+      ...accepted,
+      needsReview: true,
+      reviewReason: "uncertain",
+      answers: {},
+    };
+    vi.stubGlobal("fetch", vi.fn().mockResolvedValue(Response.json(review)));
+    expect(await classifyWithSystem1(request)).toEqual(review);
+  });
+  it.each([
+    { ...accepted, teacherCalls: 1 },
+    { ...accepted, inputTokens: 10 },
+    { ...accepted, answers: {} },
+    {
+      ...accepted,
+      answers: {
+        __rule_choice__: {
+          ...accepted.answers.__rule_choice__,
+          choice: "Unknown",
+        },
+      },
+    },
+    {
+      ...accepted,
+      answers: {
+        __rule_choice__: { ...accepted.answers.__rule_choice__, confidence: 2 },
+      },
+    },
+  ])("rejects a response outside the local contract", async (response) => {
+    vi.stubGlobal("fetch", vi.fn().mockResolvedValue(Response.json(response)));
+    await expect(classifyWithSystem1(request)).rejects.toThrow();
+  });
+  it("propagates service failure for the caller's review path", async () => {
+    vi.stubGlobal(
+      "fetch",
+      vi.fn().mockResolvedValue(new Response("unavailable", { status: 503 })),
+    );
+    await expect(classifyWithSystem1(request)).rejects.toThrow("status 503");
+  });
+});
diff --git a/apps/web/utils/classifier/system1.ts b/apps/web/utils/classifier/system1.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c2ff118ede729372afd96d19132d206d9bdac835
--- /dev/null
+++ b/apps/web/utils/classifier/system1.ts
@@ -0,0 +1,62 @@
+import { z } from "zod";
+import type {
+  ClassifierConfig,
+  ClassifierQuestion,
+  ClassifierResponse,
+} from "@/utils/classifier/classify";
+
+const probability = z.number().min(0).max(1);
+const responseSchema = z.object({
+  model: z.string(),
+  inputTokens: z.literal(0),
+  teacherCalls: z.literal(0),
+  needsReview: z.boolean(),
+  reviewReason: z.string().optional(),
+  suggestedCategory: z.string().nullable().optional(),
+  answers: z.record(
+    z.string(),
+    z.object({
+      type: z.literal("choice"),
+      choice: z.string(),
+      confidence: probability,
+      probabilities: z.record(z.string(), probability),
+    }),
+  ),
+});
+
+export async function classifyWithSystem1({
+  config,
+  state,
+  questions,
+}: {
+  config: Extract<ClassifierConfig, { provider: "system1" }>;
+  state: Record<string, unknown>;
+  questions: Record<string, ClassifierQuestion>;
+}): Promise<ClassifierResponse> {
+  const response = await fetch(new URL("/v1/classify", config.baseUrl), {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${config.apiKey}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify({ state, questions }),
+    signal: AbortSignal.timeout(5000),
+    redirect: "error",
+  });
+  if (!response.ok) {
+    throw new Error(`System1 request failed with status ${response.status}`);
+  }
+  const result = responseSchema.parse(await response.json());
+  if (!result.needsReview) {
+    const answer = result.answers.__rule_choice__;
+    const question = questions.__rule_choice__;
+    if (
+      !answer ||
+      question?.type !== "choice" ||
+      !Object.hasOwn(question.criteria, answer.choice)
+    ) {
+      throw new Error("System1 returned an unavailable rule");
+    }
+  }
+  return result;
